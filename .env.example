# ==============================================================================
# Ngumpul Host — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit real secrets to version control.

# Application Environment
# Canonical domain/app URL is configured on the /setup page (stored in
# instance_settings). No APP_URL variable is needed here.
APP_ENV=production
NGINX_PORT=1111
PORT=8080

# Image version — used by docker-compose.yml (production).
# Default: latest. Pin to a release tag e.g. v1.2.0 for stability.
IMAGE_TAG=latest

# Database Configuration (PostgreSQL)
POSTGRES_USER=ngumpul
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_DB=ngumpul_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://ngumpul:replace_with_a_secure_password@postgres:5432/ngumpul_db?sslmode=disable

# Authentication & Sessions
# Must be at least 32 characters long
SESSION_SECRET=replace_with_a_random_32_character_secret_key_12345
# Set to true when serving over HTTPS / SSL
SESSION_SECURE=false

# File & Object Storage
# Choose "s3" for SeaweedFS / S3-compatible storage, or "local" for disk storage
STORAGE_DRIVER=s3
STORAGE_PATH=/data/uploads
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=ngumpul-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=/uploads

# Transactional Email (Optional - logs to stdout if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Ngumpul Host <no-reply@example.com>"
